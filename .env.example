# Copy to .env on the server and replace every value with a generated secret.
# Never commit a real .env file.
AUTH_IMAGE_TAG=replace-with-immutable-short-git-sha
GYM_API_IMAGE_TAG=replace-with-immutable-short-git-sha

POSTGRES_ADMIN_PASSWORD=DUMMY-postgres-admin-password-0000000000000000
AUTH_DATABASE_PASSWORD=DUMMY-auth-database-password-0000000000000000
GYM_DATABASE_PASSWORD=DUMMY-gym-database-password-0000000000000000
REDIS_PASSWORD=DUMMY-redis-password-00000000000000000000000000000000
AUTH_JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nTHIS-IS-NOT-A-REAL-KEY\n-----END PRIVATE KEY-----'
CERTBOT_EMAIL=operator@example.invalid

RUSTFS_ACCESS_KEY=AAAAAAAAAAAAAAAAAAAA
RUSTFS_SECRET_KEY=DUMMY-rustfs-root-secret-00000000000000000000000000000000
S3_ACCESS_KEY=gym-api
S3_SECRET_KEY=DUMMY-gym-api-secret-00000000000000000000000000000000
S3_BACKUP_ACCESS_KEY=gym-backup
S3_BACKUP_SECRET_KEY=DUMMY-gym-backup-secret-00000000000000000000000000000000
S3_BUCKET=gym-media
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=https://onerep.mooo.com
AUTH_BASE_URL=http://auth:8080
AWS_DEFAULT_REGION=us-east-1

# Use an off-server S3 repository in production. This deliberately points nowhere.
RESTIC_REPOSITORY=s3:https://backup.example.invalid/onerep/restic
RESTIC_PASSWORD=DUMMY-restic-repository-password-00000000000000000000000000000000
RESTIC_CACHE_DIR=/root/.cache/restic
RESTIC_S3_ACCESS_KEY=DUMMY-offsite-s3-access-key
RESTIC_S3_SECRET_KEY=DUMMY-offsite-s3-secret-00000000000000000000000000000000
